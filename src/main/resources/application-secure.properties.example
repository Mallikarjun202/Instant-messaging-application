# Secure profile for local secure runs and Render deployment
# Copy to application-secure.properties locally if needed.
# Do not commit real secrets.

spring.datasource.url=${SPRING_DATASOURCE_URL}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD}

spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.show-sql=false

spring.autoconfigure.exclude=org.springframework.boot.autoconfigure.security.servlet.UserDetailsServiceAutoConfiguration
app.allowed-origin=${ALLOWED_ORIGIN}
# Required env vars on Render:
#   SPRING_PROFILES_ACTIVE=secure
#   SPRING_DATASOURCE_URL, SPRING_DATASOURCE_USERNAME, SPRING_DATASOURCE_PASSWORD
#   ALLOWED_ORIGIN=https://<your-app>.onrender.com   (no trailing slash)
#   Optional: SERVER_SERVLET_SESSION_COOKIE_SECURE=true (cookie only sent over HTTPS)
